# Encontra o valor máximo para estabilidade
M <- max(lx)
# Retorna a fórmula estável
return(M + log(sum(exp(lx - M))))
}
B <- 50000
if( length(powers) == 1){
for(i in 1:B){
# sampling from proposal (gamma)
phi_cand <- rgamma(1, powers+1, -eta1*log(rho[i]) )
# metropolis step
aux1 = sum( sj*log(phi_cand +0:(lambda1-1))) + log(sum(phi[i]^powers))
aux2 = sum( sj*log(phi[i]   +0:(lambda1-1))) + log(sum(phi_cand^powers))
ratio = exp( aux1 - aux2)
uni <- runif(1)
ifelse( uni < ratio, phi[i+1] <- phi_cand, phi[i+1] <- phi[i])
# sampling from beta
rho[i+1] <- rbeta(1,eta1 * phi[i+1] + 1, tau1+1+b)
}}else{
pr1 <- lfactorial(powers)+log(uj)
for(i in 1:B){
# sampling from proposal (gamma mixture)
pr2 = pr1 -(powers+1)*log(-eta1*log(rho[i]))
#pr3 = pr2 - max(pr2)
k <- sample(powers,1,T,prob = exp(pr2))
phi_cand <- rgamma(1, k+1, -eta1*log(rho[i]) )
# metropolis step
aux1 = sum( sj*log(phi_cand +0:(lambda1-1))) +
logsumexp( log( uj) + powers*log(phi[i]))
aux2 = sum( sj*log(phi[i] +0:(lambda1-1))) +
logsumexp( log(uj) + powers*log(phi_cand))
ratio = exp( aux1 - aux2)
uni <- runif(1)
ifelse( uni < ratio, phi[i+1] <- phi_cand, phi[i+1] <- phi[i])
# sampling from beta
rho[i+1] <- rbeta(1,eta1*phi[i+1]+1, tau1+1+b)
}
}
ts.plot(phi)
