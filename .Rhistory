set.seed(123)
y <- 1:100 + rnorm(100)
y[40:50] <- y[40:50]+50
ts.plot(y)
mod = modPoly(2)
meu_filtro <- dglmFilter_normal(y, mod)
yt <- meu_filtro$yt
n <- length(yt)
ft <- meu_filtro$ft
Qt <- meu_filtro$Qt
h = 2*sqrt(Qt)
Hs <- exp(  dnorm(yt, ft, sqrt(Qt), log =T )  -
dnorm(yt, ft + h, sqrt(Qt), log =T )  )
Hi <- exp(  dnorm(yt, ft, sqrt(Qt), log =T )  -
dnorm(yt, ft - h, sqrt(Qt), log =T )  )
Ls = Li = NULL
Ls[1] <- Hs[1]; Li <- Hi[1]
li = ls = 1
for( t in 2:n){
Ls[t] <- Hs[t]*min(1, Ls[t-1])
Li[t] <- Hi[t]*min(1, Li[t-1])
ls[t] <- ifelse( Ls[t-1] >= 1, 1, ls[t-1]+1)
li[t] <- ifelse( Li[t-1] >= 1, 1, li[t-1]+1)
}
# possiveis outliers
which( {Ls < .1355} & {ls == 1})
which( {Li < .1355} & {li == 1})
# possiveis outliers
which( {Ls < .1355} & {ls == 1})
which( {Li < .1355} & {li == 1})
which( {Ls < .1355} & {ls > 1})
which( {Li < .1355} & {li > 1})
min(1, Ls[t-1])
