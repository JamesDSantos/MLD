}
if(lambda1 > lambda0){
aj[(length(aj)+1):lambda1] <- 0
}
sj <- mj + aj
sj_floor <- floor(sj)
r <- unlist(sapply( 0:(lambda1-1), function(k) rep(k,sj_floor[k+1]) ))
#uj <- gmpPoly_coef(r[r!=0])
#uj <- coef( poly_from_roots(-r[r!=0]/sum(r) ) )
uj <- coef(calcular_coeficientes_proporcionais(-r))[-(1:(sj_floor[1]))]
powers <- sj_floor[1]:sum(sj_floor)
phi <- rho <- NULL
emv <- coefficients(fitdistr(x, 'negative binomial'))
plot( 0:(max(x)-1), mj/n, type = 's', lwd = 2, col = 'grey', lty = 2)
lines(0:(lambda1-1), sj/eta1, type='s', , lwd = 2)
phi[1] <- emv[1]
rho[1] <- emv[1]/(emv[1]+emv[2])
B <- 50000
if( length(powers) == 1){
for(i in 1:B){
# sampling from proposal (gamma)
phi_cand <- rgamma(1, powers+1, -eta1*log(rho[i]) )
# metropolis step
aux1 = sum( sj*log(phi_cand +0:(lambda1-1))) + log(sum(phi[i]^powers))
aux2 = sum( sj*log(phi[i]   +0:(lambda1-1))) + log(sum(phi_cand^powers))
ratio = exp( aux1 - aux2)
uni <- runif(1)
ifelse( uni < ratio, phi[i+1] <- phi_cand, phi[i+1] <- phi[i])
# sampling from beta
rho[i+1] <- rbeta(1,eta1 * phi[i+1] + 1, tau1+1+b)
}}else{
pr1 <- lfactorial(powers)+log(uj)
for(i in 1:B){
# sampling from proposal (gamma mixture)
pr2 = pr1 -(powers+1)*log(-eta1*log(rho[i]))
#pr3 = pr2 - max(pr2)
k <- sample(powers,1,T,prob = exp(pr2))
phi_cand <- rgamma(1, k+1, -eta1*log(rho[i]) )
# metropolis step
aux1 = sum( log(phi_cand +0:(lambda1-1))) +
log(sum( uj * phi[i]^powers))
aux2 = sum( log(phi[i] +0:(lambda1-1))) +
log(sum( uj * phi_cand^powers))
ratio = exp( aux1 - aux2)
uni <- runif(1)
ifelse( uni < ratio, phi[i+1] <- phi_cand, phi[i+1] <- phi[i])
# sampling from beta
rho[i+1] <- rbeta(1,eta1*phi[i+1]+1, tau1+1+b)
}
}
ts.plot(phi)
rho_post <- rho[-(1:(B/2))]
rho_post <- rho_post[ seq(1,length(rho_post),15)]
phi_post <- phi[-(1:(B/2))]
phi_post <- phi_post[ seq(1,length(phi_post),15)]
mu_post <- phi_post * ( 1 - rho_post) / rho_post
resp <- list( rho_post, phi_post)
names(resp) <- c('rho','phi')
#cat('--------Bayesiano---------','\n')
cat( 'mu: ', mean(mu_post, na.rm=T), ' (',sd(mu_post, na.rm = T), ') ', '\n')
cat( 'size: ', mean(phi_post), ' (',sd(phi_post) , ') ', '\n')
cat( 'rho: ', mean(rho_post), ' (',sd(rho_post) , ') ', '\n')
return(resp)
}
