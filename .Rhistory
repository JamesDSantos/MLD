require(Matrix)
W_discount = function(Pt,mod, intervention = FALSE){
delta = mod$delta
q = mod$q
Wt    = array(0, c( sum(q), sum(q)))
k <- 0
for(i in 1:length(q)){
Wt[k+1:q[i], k+1:q[i]] <- Pt[k+1:q[i], k+1:q[i]]*( 1/delta[i] - 1)
if({i == 1} & intervention){
delta_intervencao <- 0.01 # Ou 1e-6, etc.
Wt[1,1] <- Pt[1,1] * ( 1/delta_intervencao - 1)
}
k <- cumsum(q)[i]
}
Wt <- .5*( Wt + t(Wt))
return(Wt)
}
