dglmFilter_normal = function(yt,mod, m0 = NULL, C0 = NULL, nt=1,st=.01, Vt= 'unknown', Wt = 'discount', outliers = NULL, deltaV = 1){
n <- length(yt)
Ft <- mod$Ft
Gt <- mod$Gt
q <- dim(Gt)[1]
# priori at time t
at <- array(NA_real_, c(n,q))
Rt <- array(NA_real_, c(n,q,q))
# forecast for yt
ft <- array(NA_real_, n)
Qt <- array(NA_real_, n)
# posterior at time t
mt <- array( 0, c(n+1,q))
Ct <- array( NA_real_, c(n+1,q,q))
# initial information
if(is.null(m0)){
mt[1,][1] <- yt[1]
} else {
mt[1,] <- m0
}
if(is.null(C0)){
Ct[1,,] <- diag(1,q)
} else {
Ct[1,,] <- C0
}
if(is.null(outliers)){
outliers <- rep(1,n)
} else{
one_vector <- rep(1,n)
one_vector[outliers] <- 0
outliers <- one_vector
}
# Verifique se a t-student deve ser utilizada
correcao_t <- 0
Vt_final <- Vt
if( Vt == 'unknown'){
V_loop <- 1 # Vt usado dentro do loop
correcao_t <- 1
} else {
V_loop <- Vt # Vt fixo
}
# Determine se Wt é fixo ou uma string
is_Wt_discount <- (is.character(Wt) && Wt == 'discount')
if (!is_Wt_discount) {
W_fixo <- Wt # Armazena a matriz W fixa
Wt_final <- W_fixo # Guarda Wt para o retorno
}
# filtro de kalman sem desconto
for(t in 1:n){
# atualiza a priori
at[t,]   <- Gt %*% mt[t,]
Pt <-  Gt %*% Ct[t,,] %*% t(Gt)
if(is_Wt_discount){
W_calc <- W_discount(Pt, mod)
Rt[t,,] <- Pt + W_calc
if(t == n) Wt_final <- W_calc # Salva o *último* W
} else {
Rt[t,,] <- Pt + W_fixo
}
# previsão para o tempo t
ft[t] <- t(Ft) %*% at[t,]
Qt[t] <- t(Ft) %*% Rt[t,,] %*% Ft + V_loop # V_loop é 1 ou o Vt fixo
# atualiza a posteriori
At <- Rt[t,,] %*% Ft %*% solve(Qt[t])
mt[ t + 1, ] <- at[t,] + outliers[t] *(At %*% ( yt[t]- ft[t]))
Ct[ t+1,,]   <- Rt[t,,] - outliers[t]*(At %*% Qt[t] %*% t(At))
if(correcao_t == 1){
nt[t+1] <- deltaV*nt[t] + 1
st[t+1] <- (nt[t]/nt[t+1])*deltaV*st[t] + ( yt[t] - ft[t])^2 / (nt[t+1]*Qt[t])
Vt <- st[n+1]
}
}
# BLoco de reescalonamento
if( correcao_t == 1){
# Escala as variâncias *antes* da observação t (priors)
for(t in 1:n){
Rt[t,,] <- st[t] * Rt[t,,] # Escala R_t pelo s_{t-1} (que é st[t])
Qt[t]   <- st[t] * Qt[t]   # Escala Q_t pelo s_{t-1} (que é st[t])
}
# Escala as variâncias *depois* da observação t (posteriori)
for(t in 1:(n+1)){
Ct[t,,] <- st[t] * Ct[t,,] # C_t (Ct[t+1]) é escalado por s_t (st[t+1])
}
V_final <- st[n+1] # O Vt final é a última estimativa
}
resp <- list( yt = yt, mt = mt, Ct = Ct, at = at, st = st,
Rt = Rt, ft = ft, Qt = Qt, Ft = Ft, Gt = Gt, Wt = Wt_final, Vt = Vt_final)
class(resp) <- 'filter_dglm'
if( Vt == 'unknown'){
deviance <- -2*sum(dt( (yt-ft)/sqrt(Qt), nt[1:n], log = T)) +sum(log(Qt) )
} else{
deviance <- -2*sum(dnorm( yt, ft, sqrt(Qt), log = T))
}
cat('Deviance: ', deviance,'\n')
return(resp)
}
require(Matrix)
W_discount = function(Pt,mod){
delta = mod$delta
q = mod$q
Wt    = array(0, c( sum(q), sum(q)))
k <- 0
for(i in 1:length(q)){
Wt[k+1:q[i], k+1:q[i]] <- Pt[k+1:q[i], k+1:q[i]]*( 1/delta[i] - 1)
k <- cumsum(q)[i]
}
Wt <- .5*( Wt + t(Wt))
return(Wt)
}
require(magic)
require(mvtnorm)
#-----F e G para os modelos polinomiais (de crescimento)---------
modPoly <- function(order,m0=rep(0,order), C0 = diag(1,order),delta=.99){
if (order < 1) stop("A ordem deve ser pelo menos 1.")
Ft <- matrix(c(1, rep(0, order - 1)), ncol = 1)
Gt <- diag(1, order) # Cria uma matriz identidade
if (order > 1) {
# Preenche a primeira super-diagonal com 1s
indices <- seq.int(from = order + 1, by = order + 1, length.out = order - 1)
Gt[indices] <- 1
}
q = order
mod <- list( Ft = Ft, Gt = Gt, m = m0, C = C0, q = q, delta = delta)
class(mod) = c("dglm")
return(mod)
}
#-----Seasonal model - form free ---------
modSaz = function(p,m0=rep(0,p-1),C0=diag(1,p-1),W=diag(1,p-1) ,delta = .8,V=1){
W0 = W
Ft = matrix(c(1,rep(0,p-2)) , ncol = 1)
Gt = rbind( rep( -1,p-1 ) , cbind( diag(1,p-2),0 ) )
q = length(m0)
mod = list(Ft =Ft,Gt=Gt,m=m0,C=C0,W=W0,q = q, delta=delta,arma=F,V=V)
class(mod) = c("dglm")
return(mod)
}
#-----F e G para os modelos de Regressao Simples---------
ModReg = function(x,m0=rep(0,ncol(x)),C0=diag(1,ncol(x)),delta=.99,W0="NULL",V=1){
FF = array(t(x),c(ncol(x),1,nrow(x)))
GG = array(diag(1,ncol(x)), c(dim(C0),nrow(x)))
n.delta = ncol(x)
mod = list(FF=FF,GG=GG,m=m0,C=C0,W=W0,n.delta=n.delta,delta=delta,arma=F,V=V)
class(mod) = c("Mydlm","NConstante") # classe Nconstante: G_t e F_t n?o s?o constantes para todo t
return(mod)
}
#---------------------------------------------------
#-----F e G para os modelos sazonais (forma trigonometrica)---------
modTrig = function(p, harm = 1, delta = .8){
require(Matrix)
max.h <- floor(p/2) # Número máximo de harmônicos
#--- Suas excelentes mensagens de erro (mantidas) ---
if(any(harm > max.h) || length(unique(harm)) != length(harm)){
stop("Verifique os harmônicos solicitados. Eles não podem se repetir ou exceder p/2.")
}
#----------------------------------------------------
# A matriz de rotação está perfeita
J2 <- function(h) {
omega <- h * 2 * pi / p
matrix(c(cos(omega), sin(omega), -sin(omega), cos(omega)), 2, byrow = TRUE)
}
Ft_list <- list()
Gt_list <- list()
# Loop único que trata todos os casos
for (h in harm) {
# Verifica se é o caso especial de Nyquist
if (h == p/2 && p %% 2 == 0) {
Ft_list[[length(Ft_list) + 1]] <- 1
Gt_list[[length(Gt_list) + 1]] <- -1 # Correção principal: deve ser -1
} else {
# Caso normal para todos os outros harmônicos
Ft_list[[length(Ft_list) + 1]] <- c(1, 0)
Gt_list[[length(Gt_list) + 1]] <- J2(h)
}
}
# Monta as matrizes finais a partir das listas
Ft <- matrix(unlist(Ft_list), ncol = 1)
Gt <- as.matrix(bdiag(Gt_list))
# O resto do seu código está ótimo
q <- dim(Gt)[1]
m0 <- rep(0, q)
C0 <- diag(1, q)
W0 <- C0
mod <- list(Ft = Ft, Gt = Gt, m = m0, C = C0, q = q, delta = delta)
class(mod) <- c("dglm")
return(mod)
}
#-------------------------------------------------
#-----F e G para os modelos polinomiais (de crescimento)---------
ModARMA = function(phi,psi,c0=1,delta=.99,V=0){
ifelse(phi[1]==0,np<-0, np<- length(phi))
ifelse(psi[1]==0,nq<-0, nq<- length(psi))
d = max(np,nq+1)
C0 = c0*diag(1,d)
FF = matrix(c(1,rep(0,d-1)),d,1)
GG = rbind( cbind(matrix(phi[-d],ncol=1),diag(1,d-1)) , c(phi[d],rep(0,d-1)))
W0 = diag(rep(1,d))
if(psi[1]!=0){
W0 = matrix(c(1,psi[-d]),ncol=1)%*%matrix(c(1,psi[-d]),nrow=1)
}
if(psi==0){W0 <- 1}
n.delta = d
m0 = rep(0,d)
mod = list(FF=FF,GG=GG,m=m0,C=C0,W=W0,n.delta=n.delta,delta=delta,arma=T,V=V)
class(mod) = c("Mydlm","Constante")
return(mod)
}
#---------------------------------------------------
#------Seeminlgy unrelated time series equations---------------
SUTSE = function(mod,mm,level =10){        # mm ? o n?mero de s?ries temporais
FF = mod$FF%x%diag(1,mm)
GG = mod$GG%x%diag(1,mm)
m  = mod$m
m  = matrix( c(rep(level,2),rep(0,2*length(m)-2)),ncol=1)
C1 = mod$C
C = C1
for(i in 2:mm) C  = adiag(C,C1)
CC = C
mod = list(FF=FF,GG=GG,m=m,C=C,n.delta=nrow(FF),delta=mod$delta)
class(mod) = "Mydlm"
return(mod)
}
#-----Classificador----------------
UmaClasse = function(nn,mod){  # nn: n?mero de classes
FF = t(rep(1,nn)%x%t(mod$FF))
GG = mod$GG
m  = mod$m
m  = matrix( rep(0,nrow(GG)),ncol=1)
C = diag(1,nrow(GG))
mod = list(FF=FF,GG=GG,m=m,C=C,n.delta=nrow(FF),delta=mod$delta,V=mod$V)
class(mod) = c("Mydlm","Constante","UmaClasse")
return(mod)
}
#------Soma de Modelos----------------------------
"+.dglm" <- function(mod1,mod2){
delta = c(mod1$delta,mod2$delta)
q = c(mod1$q,mod2$q)
Ft = rbind(mod1$Ft,mod2$Ft)
Gt <- as.matrix( bdiag(mod1$Gt, mod2$Gt))
C <- as.matrix( bdiag(mod1$C, mod2$C))
delta = c(mod1$delta,mod2$delta)
m = c( mod1$m, mod2$m)
mod = list( Ft=Ft , Gt=Gt , m=m , C=C,q = q,delta=delta)
class(mod) = c("dglm")
return(mod)
}
